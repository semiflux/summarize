# Copy to .env and fill in. UI/CLI can also override per-job.
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_BASE=https://openrouter.ai/api/v1
# Reasoning level for reasoning-capable models: low | medium | high | off
# (empty = provider default). Ignored by non-reasoning models.
LLM_REASONING=
# Hard ceiling on reasoning tokens (0 = no ceiling). The level maps to a token
# budget clamped to this, which prevents runaway thinking (the cause of empty
# outputs). 65536 is a safe default for models with a large output budget.
LLM_REASONING_MAX_TOKENS=65536
# --- PDFs (optional) ---
# Default: each PDF page is rendered to a JPEG and sent as an image (portable,
# works with any vision model, keeps slide figures).
# PDF_AS_FILE=true sends the whole PDF as a `file` part for the provider to
# parse (OpenRouter/OpenAI); cheaper for text-heavy docs, but OCR fallbacks can
# drop figures.
PDF_AS_FILE=
# OpenRouter PDF parsing engine (only with PDF_AS_FILE): auto | native |
# mistral-ocr (billed per page) | cloudflare-ai (free).
PDF_ENGINE=auto
# Whole-file inputs above this size fall back to page rendering.
PDF_MAX_MB=50
# --- Local transcription (faster-whisper; optional) ---
# TRANSCRIBE_MODEL=large-v3-turbo
# Device: auto (GPU when CTranslate2 sees one, else CPU) | cpu | cuda.
# "cuda" also means AMD ROCm -- install the ROCm wheel (see README "AMD GPU (ROCm)").
# TRANSCRIBE_DEVICE=auto
# Compute type: auto (float16 on GPU, int8 on CPU) | int8 | int8_float16 | float16 | float32.
# TRANSCRIBE_COMPUTE_TYPE=auto
# Decode N VAD segments in parallel (faster-whisper batched pipeline). Much
# faster on a GPU; 0 decodes sequentially.
# TRANSCRIBE_BATCH_SIZE=16
PORT=8000
DATA_DIR=./data
