# Copy to .env to override. All optional -- the defaults below are the defaults.

# Where uploads and finished transcripts live. Shared between processes.
DATA_DIR=./data

# Bind address for `python -m app.main`. 127.0.0.1 is local-only; bind a LAN
# address to expose it on your network.
HOST=127.0.0.1
PORT=8100

# Speech model. large-v3-turbo is fast and accurate for lectures.
TRANSCRIBE_MODEL=large-v3-turbo
# auto (GPU when CTranslate2 sees one, else CPU) | cpu | cuda
TRANSCRIBE_DEVICE=auto
# auto (float16 on GPU, int8 on CPU) | int8 | int8_float16 | float16 | float32
TRANSCRIBE_COMPUTE_TYPE=auto
# VAD segments decoded in parallel; 0 = sequential (slower, lower VRAM).
TRANSCRIBE_BATCH_SIZE=16

# Per-request upload cap (MB).
MAX_FILE_MB=2000
# Delete finished jobs after this many hours; 0 keeps them forever.
JOB_TTL_HOURS=24
